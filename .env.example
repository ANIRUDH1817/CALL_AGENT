# Groq API Key (Free tier — get it at https://console.groq.com)
GROQ_API_KEY=

# Deepgram API Key (Free $200 credit — get it at https://console.deepgram.com)
DEEPGRAM_API_KEY=

# Optional: Webhook URL to send call notes (e.g., Zapier, Make.com, or your own endpoint)
NOTES_WEBHOOK_URL=

# Plivo credentials (get from console.plivo.com — free trial credits included)
PLIVO_AUTH_ID=your_plivo_auth_id
PLIVO_AUTH_TOKEN=your_plivo_auth_token
PLIVO_NUMBER=+1234567890

# Public URL of this server (used by outbound_caller.py to build the answer_url)
# e.g. your Cloudflare tunnel or deployed URL
SERVER_URL=https://your-tunnel.trycloudflare.com

# Path to clients JSON file (default: clients.json)
CLIENTS_FILE=clients.json

# Server port (Render will override this automatically)
PORT=5050

# Active skill (filename without .py from the skills/ directory)
# Options: personal_assistant, receptionist — or add your own in skills/
ACTIVE_SKILL=personal_assistant

# Google Gemini API Key (Free — get it at https://aistudio.google.com/apikey)
# Only needed if you set LLM_PROVIDER=gemini in a skill file
GEMINI_API_KEY=your_gemini_api_key_here
